# Локальная разработка. На Render эти значения задаются в Environment.
BOT_TOKEN=
TEAM_CHAT_ID=0
OWNER_ID=7955130892
SUPERADMIN_ID=7696380514
TEAM_INVITE=

# Локальная БД. На Render используйте DATABASE_PATH=/var/data/warden.db
DATABASE_PATH=warden.db
REDIS_URL=
LOG_LEVEL=INFO

MAIN_MENU_PHOTO_ID=
PROFILE_PHOTO_ID=
TEAM_MENU_PHOTO_ID=
OFFERS_VIDEO_ID=

# Telegram API (my.telegram.org)
API_ID=
API_HASH=

# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENC_KEY=
ACCOUNT_LEASE_TTL_MIN=30
ACCOUNT_LOGIN_MODE=bot_only

# Для Render Web Service. WEBHOOK_BASE_URL локально не нужен; Render задаёт RENDER_EXTERNAL_URL.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
# 1–256 символов: A-Z, a-z, 0-9, _ или -
WEBHOOK_SECRET=
BOT_MODE=polling
